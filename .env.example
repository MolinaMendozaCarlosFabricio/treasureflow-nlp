# Copia este archivo a ".env" y completa tu token de Hugging Face.
# Se usa en training/notebooks/NLP_treasureflow.ipynb para autenticarte
# contra el Hub (necesario para datasets/modelos con acceso restringido), y
# tambien lo usa la API (src/) para descargar el modelo Qwen si se habilita.
HF_TOKEN=

# API de moderacion (src/) -------------------------------------------------

# Habilita la capa de verificacion opcional con Qwen (via la API externa y
# gratuita de Groq -- ya NO es un modelo local) para probabilidades en zona
# dudosa (umbral +/- margen por categoria). Desactivada por defecto: "true"
# para activar. Requiere ademas GROQ_API_KEY configurada abajo; si falta,
# se considera no disponible aunque esto sea "true".
HABILITAR_QWEN=false

# Modelo de Qwen a usar para la verificacion (id tal como lo espera la API
# de Groq, no un repo de Hugging Face). Solo aplica si HABILITAR_QWEN=true.
# Verifica el id vigente en https://console.groq.com/docs/models -- Groq
# rota los modelos disponibles, y el catalogo puede cambiar.
QWEN_MODEL_NAME=qwen/qwen3.6-27b

# API key de Groq (console.groq.com), necesaria si HABILITAR_QWEN=true.
# Formato de ejemplo: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=

# Bajar modelo de inferencia NLP, modelo finetuneado
MODEL_REPO=
MODEL_REVISION=

# Broker AMQP
AMQP_URL=