# Copia este archivo a ".env" y completa tu token de Hugging Face.
# Se usa en training/notebooks/NLP_treasureflow.ipynb para autenticarte
# contra el Hub (necesario para datasets/modelos con acceso restringido), y
# tambien lo usa la API (src/) para descargar el modelo Qwen si se habilita.
HF_TOKEN=

# API de moderacion (src/) -------------------------------------------------

# Habilita la capa de verificacion opcional con Qwen para probabilidades en
# zona dudosa (umbral +/- 0.15). Desactivada por defecto: "true" para activar.
HABILITAR_QWEN=false

# Modelo de Qwen a usar para la verificacion, solo aplica si HABILITAR_QWEN=true.
QWEN_MODEL_NAME=Qwen/Qwen3-0.6B

# Bajar modelo de inferencia NLP, modelo finetuneado
MODEL_REPO=
MODEL_REVISION=